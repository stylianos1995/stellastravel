PORT=5000
JWT_SECRET=replace-with-strong-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Optional: comma-separated extra CORS origins (e.g. https://stellastravel.com)
ALLOWED_ORIGINS=
