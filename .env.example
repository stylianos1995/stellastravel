PORT=5000
JWT_SECRET=replace-with-strong-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# PostgreSQL (required) — Neon, Render Postgres, Supabase, or local
# Example (Neon): postgresql://user:password@ep-xxx.eu-west-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellas_travel
# Set true for cloud hosts if SSL is not auto-detected; false for typical local Postgres
DATABASE_SSL=false

# Optional: lock CORS to one origin (exact URL). Leave unset for Access-Control-Allow-Origin: * (all Vercel previews work).
ACCESS_CONTROL_ALLOW_ORIGIN=
# CRA: used at build time. For Vercel production, set in the dashboard to your real API (https://.../api).
REACT_APP_API_URL=http://localhost:5000/api

# Optional: demo overdue ticket in admin (set to false on production)
SEED_DEMO_OVERDUE_TICKET=false
